DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Set in production when web and API use subdomains of the same domain, e.g. yourdomain.com.
COOKIE_DOMAIN=
# Optional HTTP Basic Auth protection for /api/docs and /openapi.json.
API_DOCS_USERNAME=
API_DOCS_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STRIPE_SECRET_KEY=
# For local forwarding, `pnpm dev:stripe` injects this at runtime.
# Configure the deployed endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=

{
  "name": "techforge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:open-api": "pnpm --filter @techforge/api generate:api",
    "generate:api-web-types": "pnpm --filter @techforge/web generate:api-types",
    "generate:auth-schema": "pnpm --filter @techforge/api auth:generate",
    "db:up": "pnpm --filter @techforge/api db:up",
    "db:down": "pnpm --filter @techforge/api db:down",
    "db:reset": "pnpm --filter @techforge/api db:reset",
    "db:logs": "pnpm --filter @techforge/api db:logs",
    "db:generate": "pnpm --filter @techforge/api db:generate",
    "db:push": "pnpm --filter @techforge/api db:push",
    "db:studio": "pnpm --filter @techforge/api db:studio",
    "db:migrate": "pnpm --filter @techforge/api db:migrate",
    "db:seed": "pnpm --filter @techforge/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
  }
}

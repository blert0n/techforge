{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["API_ORIGIN", "NEXT_PUBLIC_API_URL", "STRIPE_WEBHOOK_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "lint": {},
    "typecheck": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
